# Example environment variables for local development
# Copy this to .env.local and fill the values before running the app

# Frontend Sentry DSN (public). Leave blank to disable Sentry locally.
VITE_SENTRY_DSN=

# Optional: identify the environment (development, staging, production)
VITE_SENTRY_ENV=development

# Google Gemini / API keys (examples from existing config)
GEMINI_API_KEY=

# Firebase creds (if needed for local dev previews)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NOTE: Do NOT commit your private SENTRY_AUTH_TOKEN or other secrets to source control.
# Use CI provider secrets for these values.
# ChunkFlow-IO Environment Variables Template
# Copy this file to .env.local and fill in your actual API keys
# NEVER commit .env.local to version control!

# Google Gemini API Key (required for AI conversations and image generation)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token (optional - if needed for API integrations)
# Generate from: https://github.com/settings/tokens
GitHub_Token=your_github_token_here

# Firebase Configuration (required for user authentication and data storage)
# Get these values from Firebase Console > Project Settings > General
# Create a new Firebase project at: https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
